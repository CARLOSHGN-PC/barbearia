rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function nonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        && nonEmptyString(request.resource.data.name, 80)
        && nonEmptyString(request.resource.data.imageUrl, 500)
        && (request.resource.data.availability is bool)
        && (request.resource.data.isActive is bool);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        && nonEmptyString(request.resource.data.name, 80)
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && (request.resource.data.isActive is bool);
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if request.auth == null
        && appointmentId.matches('^[A-Za-z0-9_-]+_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}$')
        && request.resource.data.id == appointmentId
        && nonEmptyString(request.resource.data.clientName, 120)
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.matches('^[0-9]{10,11}$')
        && request.resource.data.serviceId is string
        && request.resource.data.barberId is string
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validTime(request.resource.data.startTime)
        && validTime(request.resource.data.endTime)
        && request.resource.data.status == 'agendado';

      allow read, update, delete: if isAdmin();
    }
  }
}
